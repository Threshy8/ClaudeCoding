# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Shopify AU Store (OAuth — client credentials flow)
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxx

# Shopify US Store (future use)
# SHOPIFY_US_STORE_URL=https://your-us-store.myshopify.com
# SHOPIFY_US_CLIENT_ID=your-us-client-id
# SHOPIFY_US_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxx

# App
PORT=3001
FRONTEND_URL=http://localhost:3000
