# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Shopify AU Store (OAuth client credentials flow)
# Optional: store timezone for order dates (e.g. Australia/Sydney) — matches Shopify Analytics
# SHOPIFY_STORE_TIMEZONE=Australia/Sydney
# Create app in Shopify Dev Dashboard → get client_id and client_secret
# Scopes needed: read_orders, read_products
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxx

# Alternative: direct access token (legacy custom apps)
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify US Store (optional, for multi-store)
# SHOPIFY_US_STORE_URL=https://your-us-store.myshopify.com
# SHOPIFY_US_ACCESS_TOKEN=shpat_...
# or: SHOPIFY_US_CLIENT_ID + SHOPIFY_US_CLIENT_SECRET

# App
PORT=3001
FRONTEND_URL=http://localhost:3000
